# Local environment label for humans/scripts. The current Python app does not read this directly.
ARCHIMEDES_ENV=dev

# Base URL used by the Streamlit frontend when calling the FastAPI backend.
ARCHIMEDES_API_URL=http://localhost:8000/api/v1

# FastAPI Settings model values. These are read by src/api/main.py through
# pydantic-settings with the ARCHIMEDES_API_ prefix.

# Display name returned by health endpoints.
ARCHIMEDES_API_SERVICE_NAME=archimedes-api

# API version returned by health endpoints and FastAPI metadata.
ARCHIMEDES_API_API_VERSION=v1

# JSON list of browser origins allowed by FastAPI CORS middleware.
ARCHIMEDES_API_CORS_ORIGINS=["http://localhost:8501"]

# JSON list of required environment variables validated during FastAPI startup.
ARCHIMEDES_API_REQUIRED_ENV_VARS=["FOUNDRY_PROJECT_ENDPOINT"]

# Set false for local/mock runs that should start without live Foundry config.
ARCHIMEDES_API_VALIDATE_REQUIRED_ENV=false

# Storage backend for API state. Use "memory" for local-only state or "cosmos" for Cosmos DB.
ARCHIMEDES_API_STORAGE_BACKEND=cosmos

# Cosmos DB account endpoint used when ARCHIMEDES_API_STORAGE_BACKEND=cosmos.
ARCHIMEDES_API_COSMOS_ENDPOINT=

# Cosmos DB database name created/read by the API.
ARCHIMEDES_API_COSMOS_DATABASE_NAME=archimedes

# Optional Cosmos DB key. Leave empty to use DefaultAzureCredential instead.
ARCHIMEDES_API_COSMOS_KEY=

# Agent runtime: "maf" uses Microsoft Agent Framework (default), "legacy" uses the
# hand-rolled AzureOpenAI tool-call loop as a fallback.
ARCHIMEDES_API_AGENT_RUNTIME=maf

# Azure Foundry / model configuration.

# Foundry project endpoint required by the shared agent client when live agents are enabled.
FOUNDRY_PROJECT_ENDPOINT=

# Model deployment name used by the shared Foundry client.
DEFAULT_ARCHITECTURE_MODEL=gpt-4.1

# Azure OpenAI endpoint kept for hosted Azure-backed runs and deployment docs.
AZURE_OPENAI_ENDPOINT=

# Knowledge base retrieval.

# Set true to use fixture-backed KB evidence instead of Azure AI Search.
USE_MOCK_KB=true

# Azure AI Search endpoint. Use either ARCH_SEARCH_ENDPOINT or ARCH_SEARCH_SERVICE_NAME.
ARCH_SEARCH_ENDPOINT=

# Azure AI Search service name used to build https://<name>.search.windows.net.
ARCH_SEARCH_SERVICE_NAME=

# Azure AI Search query API key. Required when USE_MOCK_KB=false.
ARCH_SEARCH_API_KEY=

# Azure AI Search index name used by the KB retriever.
ARCH_KB_INDEX=archimedes-arch-idx

# Logical KB name written onto evidence records.
ARCH_KB_NAME=azure-architecture-kb

# Logical KB version written onto evidence records.
ARCH_KB_VERSION=v1
